PORT=5000
MONGODB_URI=mongodb://localhost:27017/akashic_records
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
SYSTEM_ADMIN_SECRET=your_admin_secret_key_here

# Used only by the maintenance scripts in backend/scripts. Never commit real values —
# this repository is public, so anything in a tracked file is effectively published.
AKASHIC_ADMIN_USERNAME=your_sovereign_username
AKASHIC_ADMIN_PASSWORD=your_sovereign_password
